{
  "name": "@scw/desktop",
  "productName": "Screen Co-Working",
  "version": "0.3.3",
  "private": true,
  "description": "Silent screen co-working on the office LAN",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p .",
    "dist": "electron-vite build && electron-builder && node scripts/tidy-builds.mts",
    "dist:win": "electron-vite build && electron-builder --win && node scripts/tidy-builds.mts",
    "dist:linux": "electron-vite build && electron-builder --linux && node scripts/tidy-builds.mts",
    "dist:mac": "electron-vite build && electron-builder --mac && node scripts/tidy-builds.mts",
    "publish-update": "node scripts/publish-update.mts",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "audit:ui": "electron-vite build && playwright test -c test/audit",
    "builds:fetch": "node scripts/fetch-builds.mts"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "antd": "^6.7.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "livekit-client": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "ws": "^8.22.1"
  },
  "author": "Elvin Huseynov",
  "homepage": "https://github.com/codewithelvin/screen-co-working"
}
