# The server's LAN IP address, advertised to clients for media (UDP 40000-40100).
NODE_IP=192.168.1.10
LIVEKIT_API_KEY=scw
# At least 32 characters: `openssl rand -base64 32`
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret-value
# Optional; default is ws://<host the app used for the API>:7880
LIVEKIT_PUBLIC_URL=
